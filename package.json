{
  "name": "pocket-game-maker",
  "productName": "Pocket-Game-Maker",
  "version": "0.9.7",
  "description": "A game maker for monster-taming and monster-capturing RPGs.",
  "homepage": "https://github.com/Pocket-Designs/pocket-game-maker",
  "main": "main.js",
  "desktopName": "pocket-game-maker.desktop",
  "author": {
    "name": "Pocket-Designs",
    "email": "pocket-designs@proton.me"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js && node test/exporter.test.js",
    "gen-sample": "node tools/gen-library.js && node tools/gen-sample.js",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "gen-library": "node tools/gen-library.js",
    "gen-audio": "node tools/gen-audio.js",
    "test:export": "electron test/export-main.js",
    "test:editing": "electron test/editing-main.js",
    "test:home": "electron test/home-main.js",
    "test:debugger": "electron test/debugger-main.js",
    "test:pixel": "electron test/pixel-editor-main.js",
    "test:cutscene": "electron test/cutscene-main.js",
    "test:features": "electron test/features-main.js",
    "test:view25": "electron test/view25-main.js",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pocketdesigns.pocketgamemaker",
    "productName": "Pocket-Game-Maker",
    "icon": "build/icon.ico",
    "afterPack": "build/adhoc-sign.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "templates/**/*",
      "package.json",
      "library/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pocket-Game-Maker",
      "artifactName": "Pocket-Game-Maker-Setup-${version}.${ext}",
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "Pocket-Game-Maker-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "Pocket-Game-Maker-${version}-linux-${arch}.${ext}",
      "synopsis": "A game maker for monster-taming RPGs",
      "maintainer": "Pocket-Designs <pocket-designs@proton.me>",
      "executableName": "pocket-game-maker",
      "syncDesktopName": true
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/rcedit/bin/**"
    ],
    "compression": "maximum",
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "copyright": "Copyright \u00a9 2026 Pocket-Designs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon-1024.png",
      "artifactName": "Pocket-Game-Maker-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Pocket-Game-Maker ${version}"
    }
  },
  "dependencies": {
    "rcedit": "^4.0.1",
    "yauzl": "^3.4.0",
    "yazl": "^2.5.1"
  }
}
